rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isAdmin(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';}
  match /counters/{counterId}{
   allow read: if signedIn() && counterId == 'studentCounter';
   allow create: if signedIn() && counterId == 'studentCounter' && request.resource.data.keys().hasOnly(['count','updatedAt']) && request.resource.data.count == 304;
   allow update: if signedIn() && counterId == 'studentCounter' && request.resource.data.keys().hasOnly(['count','updatedAt']) && request.resource.data.count == resource.data.count + 1;
   allow delete: if false;
  }
  match /users/{userId}{
   allow create: if signedIn() && request.auth.uid==userId && request.resource.data.uid==userId && request.resource.data.role=='student' && request.resource.data.email==request.auth.token.email;
   allow read: if signedIn() && (request.auth.uid==userId || isAdmin());
   allow update: if isAdmin() || (signedIn() && request.auth.uid==userId && request.resource.data.role==resource.data.role && request.resource.data.uid==resource.data.uid && request.resource.data.email==resource.data.email && request.resource.data.keys().hasOnly(['uid','studentId','name','email','mobile','school','studentClass','role','createdAt','updatedAt']));
   allow delete: if isAdmin();
  }
  match /quizzes/{quizId}{allow read: if isAdmin() || (signedIn() && resource.data.published==true);allow create,update,delete: if isAdmin();}
  match /quizKeys/{quizId}{allow read,write: if isAdmin();}
  match /submissions/{submissionId}{
   allow read: if isAdmin() || (signedIn() && resource.data.uid==request.auth.uid);
   allow create: if signedIn() && submissionId==request.auth.uid+"_"+request.resource.data.quizId && exists(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId)) && get(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId)).data.published==true && request.resource.data.uid==request.auth.uid && request.resource.data.status=='in_progress' && request.resource.data.keys().hasOnly(['uid','quizId','quizTitle','status','startedAt','durationMinutes','questionCount','createdAt']) && request.resource.data.durationMinutes>=1 && request.resource.data.durationMinutes<=240 && request.resource.data.questionCount>=1;
   allow update: if isAdmin() || (signedIn() && resource.data.uid==request.auth.uid && resource.data.status=='in_progress' && request.resource.data.uid==resource.data.uid && request.resource.data.quizId==resource.data.quizId && request.resource.data.status=='submitted' && request.resource.data.keys().hasOnly(['uid','quizId','quizTitle','status','startedAt','durationMinutes','questionCount','createdAt','answers','submittedAt','submittedClientAt']) && request.resource.data.answers.size()==resource.data.questionCount && request.resource.data.answers.toSet().hasOnly([0,1,2,3,-1]));
   allow delete: if isAdmin();
  }
  match /results/{resultId}{allow create,update,delete: if isAdmin();allow read: if isAdmin() || (signedIn() && resource.data.uid==request.auth.uid);}
  match /{document=**}{allow read,write: if false;}
 }
}